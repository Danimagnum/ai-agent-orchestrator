# Upload this file too (FTP clients may hide dotfiles).
DirectoryIndex index.html

<IfModule mod_headers.c>
  Header always unset X-Frame-Options
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self' https://danielgil.eu https://www.danielgil.eu"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ALTERNATIVE if Raiola rejects Header in .htaccess (HTTP 500):
# Comment out the whole <IfModule mod_headers.c> block above and request that
# Raiola applies this in the domain/vhost configuration or hosting header panel:
# Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self' https://danielgil.eu https://www.danielgil.eu
# X-Content-Type-Options: nosniff
# Referrer-Policy: strict-origin-when-cross-origin
# Also remove an inherited X-Frame-Options that conflicts with the CSP.
# frame-ancestors CANNOT be enforced by a meta tag or JavaScript.
# Do not claim restricted framing until the HTTP header is verified in DevTools.

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
