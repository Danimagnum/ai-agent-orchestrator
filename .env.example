# docker compose up works without copying this file. These are optional overrides.
MOCK_LLM=true
MOCK_CHUNK_DELAY_MS=45
WORKER_CONCURRENCY=3
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
# Local, non-container development only:
DATABASE_URL=postgres://orchestrator:orchestrator@127.0.0.1:5432/orchestrator
REDIS_URL=redis://127.0.0.1:6379
